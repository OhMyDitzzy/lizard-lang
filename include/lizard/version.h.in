#ifndef LIZARD_VERSION_H
#define LIZARD_VERSION_H

/*
 * Generated by cmake/GenerateBuildInfo.cmake on every build; do not edit the generated copy.
 * The facts are the same as in share/doc/lizard/BUILDINFO.
 */

#define LZ_VERSION_MAJOR @PROJECT_VERSION_MAJOR@
#define LZ_VERSION_MINOR @PROJECT_VERSION_MINOR@
#define LZ_VERSION_PATCH @PROJECT_VERSION_PATCH@
#define LZ_VERSION_CORE "@PROJECT_VERSION@"

/* 0.1.0 (release) | 0.1.0-dev.12+gabc1234 (snapshot) | ...+gabc1234.dirty.1a2b3c4d (dirty) | 0.1.0+source */
#define LZ_VERSION_STRING "@LZ_VERSION_FULL@"

/* release | snapshot | dirty | source */
#define LZ_BUILD_KIND "@LZ_BUILD_KIND@"
#define LZ_BUILD_DIRTY @LZ_BUILD_DIRTY@
#define LZ_BUILD_DIRTY_HASH "@LZ_BUILD_DIRTY_HASH@" /* hash of the uncommitted changes; "" when clean */

#define LZ_BUILD_COMMIT "@LZ_BUILD_COMMIT@"
#define LZ_BUILD_COMMIT_SHORT "@LZ_BUILD_COMMIT_SHORT@"
#define LZ_BUILD_DATE "@LZ_BUILD_DATE@" /* commit date (or SOURCE_DATE_EPOCH), never the wall clock */

/* local (unsigned) | official (signed by LZ_BUILD_SIGNER, verify the detached .asc of the package) */
#define LZ_BUILD_CHANNEL "@LZ_BUILD_CHANNEL@"
#define LZ_BUILD_SIGNED @LZ_BUILD_SIGNED@
#define LZ_BUILD_SIGNER "@LZ_BUILD_SIGNER@"

#define LZ_BUILD_CONFIG "@LZ_BUILD_CONFIG@" /* Release, Debug, ... */
#define LZ_BUILD_TARGET "@LZ_BUILD_TARGET@"
#define LZ_BUILD_COMPILER "@LZ_BUILD_COMPILER@"
#define LZ_BUILD_JIT @LZ_BUILD_JIT@
#define LZ_BUILD_LTO @LZ_BUILD_LTO@
#define LZ_BUILD_SANITIZERS @LZ_BUILD_SANITIZERS@
#define LZ_BUILD_STATIC @LZ_BUILD_STATIC@

/*
 * What `lizard --version` prints. The first line is the version alone, which scripts rely on
 * (tests/skink_check.sh).
 */
#define LZ_VERSION_LONG                                                                            \
    LZ_VERSION_STRING "\n"                                                                         \
    "build    " LZ_BUILD_KIND " (" LZ_BUILD_CONFIG ")\n"                                           \
    "commit   " LZ_BUILD_COMMIT " " LZ_BUILD_DATE "\n"                                             \
    "channel  " LZ_BUILD_CHANNEL "@LZ_BUILD_CHANNEL_NOTE@\n"                                       \
    "target   " LZ_BUILD_TARGET ", " LZ_BUILD_COMPILER "\n"                                       \
    "features jit=@LZ_BUILD_JIT_TEXT@ lto=@LZ_BUILD_LTO_TEXT@ sanitizers=@LZ_BUILD_SANITIZERS_TEXT@ static=@LZ_BUILD_STATIC_TEXT@"

#endif
