# Fill an array, take prefix sums in place, then fold it: indexing with a computed index.
let n = 600000
let xs = []
let i = 0
while i < n {
  push(xs, i % 10)
  i = i + 1
}
i = 1
while i < n {
  xs[i] = xs[i] + xs[i - 1]
  i = i + 1
}
let total = 0
i = 0
while i < n {
  total = total + xs[i] % 3
  i = i + 1
}
println(xs[n - 1], total)
