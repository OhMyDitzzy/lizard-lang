# A small bank: accounts as objects in a dict, a stream of transfers, errors caught and counted.
class Account {
  pub read id: string
  pub read balance: int = 0
  moves: int = 0

  pub fn deposit(self, amount: int) {
    self.balance += amount
    self.moves += 1
  }

  pub fn withdraw(self, amount: int) {
    if amount > self.balance {
      throw ValueError("insufficient funds")
    }
    self.balance -= amount
    self.moves += 1
  }

  pub get activity(self) => self.moves
}

let N = 150000
let accounts = {}
let ids = []
for k in 0..500 {
  let id = $"acc{k:03d}"
  accounts[id] = Account(id, 1000)
  ids.push(id)
}
let seed = 42
let failed = 0
let i = 0
while i < N {
  seed = (seed * 1103515245 + 12345) % 2147483648
  let from = accounts[ids[seed // 256 % 500]]
  let to = accounts[ids[seed // 65536 % 500]]
  let amount = seed % 400 + 1
  try {
    from.withdraw(amount)
    to.deposit(amount)
  } catch e {
    failed += 1
  }
  i += 1
}
let total = 0
let busiest = 0
for id, acct in accounts {
  total += acct.balance
  if acct.activity > busiest {
    busiest = acct.activity
  }
}
println(total, failed, busiest)
