# Errors: try / catch / finally / throw, and the kinds of error.

# 1. A safe division: catch only the failure you expect.
fn safe_div(a, b) {
  try {
    return a / b
  } catch ArithmeticError as _ {
    return nil
  }
}
println(safe_div(6, 3), safe_div(1, 0) ?? "cannot divide by zero")

# 2. Parsing numbers: a bad text is a ValueError.
fn parse(text) {
  try {
    return int(text)
  } catch ValueError as e {
    println("skipped:", e.message)
    return nil
  }
}
println(["10", "x", "30"].map(parse))

# 3. Cleanup with finally: it runs after a return, an error, a break.
fn work(n) {
  try {
    println("start", n)
    if n > 1 { throw RangeError($"{n} is too big") }
    return "ok"
  } catch RangeError as e {
    return "failed: " + e.message
  } finally {
    println("cleanup", n)
  }
}
println(work(1))
println(work(2))

for i in 0..4 {
  try {
    if i equal 1 { continue }
    if i equal 3 { break }
    println("round", i)
  } finally {
    println("end of round", i)
  }
}

# 4. The hierarchy: RuntimeError catches RangeError, ArithmeticError, ...; Error catches all.
for action in [0, 1, 2, 3] {
  try {
    switch action {
      case 0 { println([1, 2][5]) }
      case 1 { println(1 / 0) }
      case 2 { throw IOError("disk gone") }
      else { println("fine") }
    }
  } catch RuntimeError as e {
    println("runtime problem:", e.kind)
  } catch e {
    println("other:", e)
  }
}

# 5. Throwing again: the trace stays that of the first throw.
fn inner() { throw ValueError("deep") }
fn outer() {
  try {
    inner()
  } catch e {
    println("outer saw", e.message, "then throws it again")
    throw e
  }
}
try {
  outer()
} catch e {
  println(e.kind, e.message)
  println(e.trace[0])
}

# 6. An error inside a callback is caught outside it.
try {
  println([4, 2, 0, 1].map(fn(n) => 8 / n))
} catch e {
  println("map failed:", e.kind)
}

# 7. Your own kinds: `error Name : Parent` (Error when there is no parent). The declaration is
# hoisted: a kind can be used above the line that declares it.
try {
  throw NotFound("config.lz is missing")
} catch IOError as e {
  println("io problem:", e.kind, e.message)   # NotFound is an IOError
}
error NotFound : IOError
error ParseError : ValueError
error AppError                                  # its parent is Error

# 8. `cause` keeps the error that led to this one, `data` carries anything you want to hand on.
fn load(path) {
  throw NotFound(path + " is missing")
}
fn parse_config(path) {
  try {
    load(path)
  } catch NotFound as e {
    throw ParseError("cannot read the configuration", cause: e, data: {"path": path, "line": 3})
  }
}
try {
  parse_config("config.lz")
} catch ParseError as e {
  println(e.kind, e.message)
  println("caused by", e.cause.kind, e.cause.message)
  println("data", e.data["path"], e.data["line"])
  println(e.cause.cause, AppError("plain").data)    # nil nil: no cause and no data
}

# 9. A kind is a function: build the error first, then throw it.  `throw NotFound` is a mistake.
let make = [NotFound, ParseError, AppError]
for kind in make {
  try { throw kind("made by a variable") } catch e { println(e.kind) }
}

# 10. An error that nobody catches prints its causes under the report:
#
#   error: ParseError: cannot read the configuration
#     = caused by: NotFound: config.lz is missing
#
# parse_config("config.lz")

# 11. The limits of the sandbox cannot be caught: nothing below would print.
# try { while true { } } catch e { println("never") } finally { println("never") }
