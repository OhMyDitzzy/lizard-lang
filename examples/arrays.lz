let xs = [1, 2, 3]
let ys: int[] = [4, 5]
let empty: string[] = []

println(xs[0], xs[-1])          # 1 3
xs[0] = 10
println(xs[1:3], xs + ys)       # [2, 3] [10, 2, 3, 4, 5]

push(xs, 7)
println(pop(xs), len(xs))       # 7 3
insert(xs, 1, 99)
println(xs, remove(xs, 0))      # [99, 2, 3] 10   (xs prints after the removal)

# Typed arrays keep their element type
push(ys, 6)
# push(ys, "x")                 # type error: array of int cannot hold string
push(empty, "a")

# A loop over the items (there is no `for` yet)
let squares = []
let i = 0
let numbers = range(1, 6)
while i < len(numbers) {
  push(squares, numbers[i] * numbers[i])
  i = i + 1
}
println(squares, sum(squares), min(squares), max(squares))
reverse(squares)
sort(squares)
println(join(squares, ", "), contains(squares, 16), index_of(squares, 99))

# Nested arrays
let grid: int[][] = [[1, 2], [3, 4]]
grid[1][0] = 30
println(grid, grid[1][-1])
